# Docker compose stack settings
COMPOSE_PROJECT_NAME='draxa'
CONTAINER_REGISTRY_PREFIX=''
VERSION=0.0.1

#
APP_IMAGE_NAME=draxa
PORT=80

# App
APP_SECRET=changeme
DATABASE_URL="postgresql://postgres:postgres@draxa-postgres:5432/draxa?serverVersion=16&charset=utf8"
MAILER_URL=null://localhost

# Traefik
TRAEFIK_HOST=draxa.example.com

# Postgres container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_NAME=draxa
POSTGRES_PORT=5432
