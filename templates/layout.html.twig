{% extends 'base.html.twig' %}

{% use 'todo/index.html.twig' %}

{% block body %}
    <nav class="barMenu">
        <div class="nav-container">
            <a class="title" href="{{ path('accueil') }}" aria-label="Cepta – accueil">
                <svg class="title__logo" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                    <rect width="28" height="28" rx="7" fill="var(--brand)"/>
                    <path d="M18.5 9.2a6.5 6.5 0 1 0 0 9.6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/>
                    <circle cx="19.2" cy="14" r="1.9" fill="var(--brand-light)"/>
                </svg>
                Cepta
            </a>
            <ul class="menu">
                <li class="menu-item">
                    <button type="button" class="user-link user-alone" id="todo-list" aria-label="Liste des tâches" title="Liste des tâches">
                        <span class="glyphicon glyphicon-check"></span>
                    </button>
                    <div class="todo__notification">0</div>
                </li>
                <li class="menu-item {{ title=='Accueil' ? 'active' : '' }}">
                    <a class="user-link" href="{{ path('accueil') }}">
                        <span class="glyphicon glyphicon-home"></span>
                        Accueil
                    </a>
                </li>
                <li class="menu-item {{ title in ['Liste des patients', 'Vue', 'Create', 'Diagnostic éducatif'] ? 'active' : '' }}">
                    <a class="user-link" href="{{ path('patient_list') }}">
                        <span class="glyphicon glyphicon-list-alt"></span>
                        Liste des patients
                    </a>
                </li>

                {% if is_granted('ROLE_ADMIN') %}
                    <li class="menu-item {{ title=='Statistiques' ? 'active' : '' }}">
                        <a class="user-link" href="{{ path('statistiques') }}">
                            <span class="glyphicon glyphicon-stats"></span>
                            Statistiques
                        </a>
                    </li>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <li class="menu-item {{ title in ['Settings', 'Years', 'Soignants'] ? 'active' : '' }}">
                        <button type="button" class="user-link" aria-haspopup="true">
                            <span class="glyphicon glyphicon-cog"></span>
                            Réglages
                        </button>
                        <ul class="menu-content">
                            <li class="menu-item">
                                <a class="user-link" href="{{ path('settings', {'year': "now"|date("Y")}) }}">
                                    <span class="glyphicon glyphicon-calendar"></span>
                                    Gérer les semaines
                                </a>
                            </li>
                            <li class="menu-item">
                                <a class="user-link" href="{{ path('year') }}">
                                    <span class="glyphicon glyphicon-th"></span>
                                    Calendrier des années
                                </a>
                            </li>
                            <li class="menu-item">
                                <a class="user-link" href="{{ path('soignant') }}">
                                    <span class="glyphicon glyphicon-user"></span>
                                    Gérer les soignants
                                </a>
                            </li>
                        </ul>
                    </li>
                {% endif %}
                <li class="menu-item">
                    <a class="user-link" href="{{ path('logout') }}" aria-label="Se déconnecter" title="Se déconnecter">
                        <span class="glyphicon glyphicon-log-out"></span>
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Todo -->
    {% block todo %}{{ parent() }}{% endblock %}

    <div class="container container-fluid">
        {% block page_content %}{% endblock %}
    </div>
    <div class="toolbar">
        <a class="cd cd-top js-cd-top" href="#0" aria-label="Revenir en haut de la page" title="Revenir en haut de la page"><span class="glyphicon glyphicon-chevron-up"></span></a>
        {% block toolbar_component %}{% endblock %}
    </div>

    <!-- Permanent banner -->
    <div id="banner" class="banner" role="note">
        <span class="glyphicon glyphicon-earphone banner__icon" aria-hidden="true"></span>
        <p class="banner__text">
            Un problème avec l’agenda partagé ?
            <span class="banner__contact">Sabrina Bernadet <span class="banner__tel">49357</span></span>
            <span class="banner__contact">Gaëlle Dufau <span class="banner__tel">23384</span></span>
        </p>
        <button type="button" class="banner__close" aria-label="Masquer ce message pendant une heure" title="Masquer pendant une heure"><span class="glyphicon glyphicon-remove"></span></button>
    </div>

    <!-- Modale de confirmation commune (voir confirmAction dans top.js) -->
    <div id="confirmModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="confirmModalTitle">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">&times;</button>
                    <h4 class="modal-title" id="confirmModalTitle">
                        <span class="glyphicon glyphicon-warning-sign"></span>
                        <span class="js-confirm-title">Suppression</span>
                    </h4>
                </div>
                <div class="modal-body">
                    <p class="js-confirm-message"></p>
                    <div class="modal-btn">
                        <button type="button" class="btn btn-danger js-confirm-ok">
                            <span class="glyphicon glyphicon-trash"></span>
                            <span class="js-confirm-label">Supprimer</span>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default pull-left js-confirm-cancel" data-dismiss="modal">
                        <span class="glyphicon glyphicon-remove"></span>
                        Annuler
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="bas">
        <section class="footer-minimal footer-dark" id="footer">
            <div class="footer-container footer-flex">
                <div class="footer-copyright">
                        <p>Conception : <a href="https://github.com/Suissehide/Draxa" target="_blank">Léo Couffinhal</a></p>
                </div>
                <div class="footer-copyright">
                    <p class="text-right">© <a href="https://qwetle.fr" target="_blank">Qwetle</a> 2020 – {{ "now"|date("Y") }}</p>
                </div>
            </div>
        </section>
    </div>
    
{% endblock %}

{% block default_javascripts %}

{% block todo_javascripts %}
    <script src="{{ asset('js/script.js') }}"></script>
    {{ parent() }}
{% endblock %}

{% endblock %}
