{% extends 'base.html.twig' %}

{% use 'todo/index.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block body %}
    <div class="app-shell">
        <aside class="app-sidebar">
            <nav class="sidebar" aria-label="Navigation principale">
                <div class="sidebar__top">
                    <a class="sidebar__brand" href="{{ path('accueil') }}" aria-label="Cepta – accueil">
                        <img class="sidebar__logo" src="{{ asset('img/logo-cepta.svg') }}" alt="" width="34" height="34">
                        <span class="sidebar__brand-text">
                            <span class="sidebar__name">Cepta</span>
                            <span class="sidebar__tagline">Programme ETP</span>
                        </span>
                    </a>
                    <button type="button" class="sidebar__todo" id="todo-list" aria-label="Tâches" title="Tâches" aria-expanded="false" aria-controls="todo-panel">
                        {{ icons.icon('tasks', 20) }}
                        <span class="todo__notification" aria-hidden="true">0</span>
                    </button>
                </div>

                <ul class="sidebar__menu">
                    <li>
                        <a class="sidebar__link {{ title == 'Accueil' ? 'is-active' }}"{% if title == 'Accueil' %} aria-current="page"{% endif %} href="{{ path('accueil') }}">
                            {{ icons.icon('calendar') }} Agenda du jour
                        </a>
                    </li>
                    <li>
                        <a class="sidebar__link {{ title in ['Liste des patients', 'Vue', 'Create', 'Diagnostic éducatif'] ? 'is-active' }}"{% if title in ['Liste des patients', 'Vue', 'Create', 'Diagnostic éducatif'] %} aria-current="page"{% endif %} href="{{ path('patient_list') }}">
                            {{ icons.icon('users') }} Patients
                        </a>
                    </li>
                    {% if is_granted('ROLE_ADMIN') %}
                        <li>
                            <a class="sidebar__link {{ title == 'Statistiques' ? 'is-active' }}"{% if title == 'Statistiques' %} aria-current="page"{% endif %} href="{{ path('statistiques') }}">
                                {{ icons.icon('stats') }} Statistiques
                            </a>
                        </li>
                    {% endif %}
                </ul>

                {% if is_granted('ROLE_ADMIN') %}
                    <p class="sidebar__section">Réglages</p>
                    <ul class="sidebar__menu">
                        <li>
                            <a class="sidebar__link {{ title == 'Settings' ? 'is-active' }}"{% if title == 'Settings' %} aria-current="page"{% endif %} href="{{ path('settings', {'year': "now"|date("Y")}) }}">
                                {{ icons.icon('weeks') }} Semaines &amp; créneaux
                            </a>
                        </li>
                        <li>
                            <a class="sidebar__link {{ title == 'Years' ? 'is-active' }}"{% if title == 'Years' %} aria-current="page"{% endif %} href="{{ path('year') }}">
                                {{ icons.icon('grid') }} Calendrier des années
                            </a>
                        </li>
                        <li>
                            <a class="sidebar__link {{ title == 'Soignants' ? 'is-active' }}"{% if title == 'Soignants' %} aria-current="page"{% endif %} href="{{ path('soignant') }}">
                                {{ icons.icon('user') }} Soignants
                            </a>
                        </li>
                    </ul>
                {% endif %}

                <div class="sidebar__spacer"></div>

                {% include '_assistance.html.twig' with {'variant': 'sidebar'} %}

                <div class="sidebar__user">
                    <span class="sidebar__avatar" aria-hidden="true">{{ app.user ? app.user.userIdentifier|slice(0, 2)|upper : '' }}</span>
                    <span class="sidebar__user-text">
                        <span class="sidebar__user-name">{{ app.user ? app.user.userIdentifier : '' }}</span>
                        <span class="sidebar__user-role">{{ is_granted('ROLE_ADMIN') ? 'Administrateur' : 'Soignant' }}</span>
                    </span>
                    <a class="sidebar__logout" href="{{ path('logout') }}" aria-label="Se déconnecter" title="Se déconnecter">{{ icons.icon('logout') }}</a>
                </div>
            </nav>
        </aside>

        <div class="app-main">
            {# Panneau des tâches #}
            {% block todo %}{{ parent() }}{% endblock %}

            <main class="container container-fluid">
                {% block page_content %}{% endblock %}
            </main>

            <footer class="app-footer" id="footer">
                <span></span>
                <span>© <a href="https://qwetle.fr" target="_blank" rel="noopener">Qwetle</a> 2020 – {{ "now"|date("Y") }}</span>
            </footer>
        </div>
    </div>

    <div class="toolbar">
        <a class="cd cd-top js-cd-top" href="#0" aria-label="Revenir en haut de la page" title="Revenir en haut de la page">{{ icons.icon('chevron-up', 20) }}</a>
        {% block toolbar_component %}{% endblock %}
    </div>

    <!-- Modale de confirmation commune (voir confirmAction dans top.js) -->
    <div id="confirmModal" class="modal fade" tabindex="-1" role="alertdialog" aria-labelledby="confirmModalTitle">
        <div class="modal-dialog modal-sm-wide">
            <div class="modal-content">
                <div class="modal-body confirm">
                    <span class="confirm__icon">{{ icons.icon('warning', 22) }}</span>
                    <h4 class="modal-title" id="confirmModalTitle"><span class="js-confirm-title">Suppression</span></h4>
                    <p class="js-confirm-message"></p>
                    <div class="confirm__actions">
                        <button type="button" class="btn btn-default js-confirm-cancel" data-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-danger js-confirm-ok"><span class="js-confirm-label">Supprimer</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block default_javascripts %}

{% block todo_javascripts %}
    <script src="{{ asset('js/script.js') }}"></script>
    {{ parent() }}
{% endblock %}

{% endblock %}
