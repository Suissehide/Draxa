{% block javascripts %}
<script>
    $('.input-daterange').datepicker({
        language: 'fr',
        format: 'dd/mm/yyyy',
        todayBtn: true,
        todayHighlight: false,
        autoclose: false
    });

    var savedDebut = localStorage.getItem('stat_dateDebut');
    var savedFin = localStorage.getItem('stat_dateFin');
    if (savedDebut && savedFin) {
        $('#dateDebut').datepicker('setDate', savedDebut);
        $('#dateFin').datepicker('setDate', savedFin);
    } else {
        $('#dateDebut').datepicker('setDate', new Date());
        let endDate = moment().endOf('year').format('DD/MM/YYYY');
        $('#dateFin').datepicker('setDate', endDate);
    }
    $('.input-daterange input').datepicker('update');

    const thematiques = {{ thematiques|json_encode|raw }};
    const anchorList = ['consultations', 'entretiens', 'coachings', 'ateliers', 'educatives'];

    function ajaxAction() {
        localStorage.setItem('stat_dateDebut', $('#dateDebut').val());
        localStorage.setItem('stat_dateFin', $('#dateFin').val());
        $('#loading').show();
        $.ajax({
            url: "{{ path('statistiques') }}",
            type: "POST",
            dataType: "json",
            data: {
                dateStart: $('#dateDebut').val(),
                dateEnd: $('#dateFin').val()
            },
            complete: function () {
                $('#loading').hide();
            },
            success: function (res) {
                $(".box tbody tr").remove();

                for (let statistique in res['statistiques']) {
                    for (let data in res['statistiques'][statistique]) {
                        var $el = $('#' + statistique).find('.stats[data-key="' + data + '"]');
                        if (!$el.length) $el = $('#' + statistique).find('.stats').eq(data - 1);
                        $el.find('.stats-number').text(res['statistiques'][statistique][data]);
                    }
                }

                for (let thematique in res['slots']) {
                    for (let etat in res['slots'][thematique]) {
                        let line = $('<tr data-row-id=' + 0 + ' class="text-left">');
                        line.append('<td class="stat-cell-label">' + thematiques[thematique][etat] + '</td>')
                        $.each(res['slots'][thematique][etat], function (index, val) {
                            let color = "stat-cell";
                            if (index === 0)
                                color += " hotpink";
                            else if (index === 1)
                                color += " gold";
                            line.append('<td class="' + color + '">' + val + '</td>')
                        });
                        line.appendTo('#' + thematique);
                    }
                }
                // Activite par soignant
                $('#soignants tbody').empty();
                if (res.soignants) {
                    var categories = ['Consultation', 'Entretien', 'Coaching'];
                    var totalsOui = {}, totalsNon = {}, totalOuiAll = 0, totalNonAll = 0;
                    categories.forEach(function(c) { totalsOui[c] = 0; totalsNon[c] = 0; });
                    $.each(res.soignants, function(nom, cats) {
                        var $tr = $('<tr>').append('<td class="stat-cell-label">' + nom + '</td>');
                        var total = 0;
                        for (var i = 0; i < categories.length; i++) {
                            var c = cats[categories[i]];
                            $tr.append('<td class="stat-cell">' + c.oui + '</td>');
                            $tr.append('<td class="stat-cell">' + c.non + '</td>');
                            totalsOui[categories[i]] += c.oui;
                            totalsNon[categories[i]] += c.non;
                            totalOuiAll += c.oui;
                            totalNonAll += c.non;
                            total += c.oui + c.non;
                        }
                        $tr.append('<td class="stat-cell">' + total + '</td>');
                        $tr.appendTo('#soignants tbody');
                    });
                    var $totalsRow = $('<tr>').append('<td class="stat-cell-label" style="font-weight:bold">Total</td>');
                    for (var i = 0; i < categories.length; i++) {
                        $totalsRow.append('<td class="stat-cell" style="font-weight:bold">' + totalsOui[categories[i]] + '</td>');
                        $totalsRow.append('<td class="stat-cell">' + totalsNon[categories[i]] + '</td>');
                    }
                    $totalsRow.append('<td class="stat-cell" style="font-weight:bold">' + (totalOuiAll + totalNonAll) + '</td>');
                    $totalsRow.appendTo('#soignants tbody');
                }

                // Moyenne patients par atelier
                $('#moyAteliers tbody').empty();
                if (res.moyAteliers) {
                    var totalSlots = 0, totalOui = 0, nbThem = 0;
                    var sumOui = 0, sumNon = 0;
                    $.each(res.moyAteliers, function(them, d) {
                        $('<tr>')
                            .append('<td class="stat-cell-label">' + them + '</td>')
                            .append('<td class="stat-cell">' + d.slots + '</td>')
                            .append('<td class="stat-cell">' + d.oui + '</td>')
                            .append('<td class="stat-cell">' + d.non + '</td>')
                            .append('<td class="stat-cell" style="font-weight:bold">' + d.moyOui + '</td>')
                            .appendTo('#moyAteliers tbody');
                        totalSlots += d.slots;
                        sumOui += d.oui;
                        sumNon += d.non;
                        totalOui += d.moyOui;
                        nbThem++;
                    });
                    if (nbThem > 0) {
                        var avgOui = +(totalOui / nbThem).toFixed(1);
                        $('<tr style="font-weight:bold">')
                            .append('<td class="stat-cell-label">Total</td>')
                            .append('<td class="stat-cell">' + totalSlots + '</td>')
                            .append('<td class="stat-cell">' + sumOui + '</td>')
                            .append('<td class="stat-cell">' + sumNon + '</td>')
                            .append('<td class="stat-cell">' + avgOui + '</td>')
                            .appendTo('#moyAteliers tbody');
                    }
                }

                // Patients avec donnees manquantes
                if (res.patientsManquants) {
                    var manquants = res.patientsManquants;
                    $.each(['orientation', 'dedate', 'mode', 'spontane'], function(i, key) {
                        var list = manquants[key] || [];
                        $('#count-' + key).text(list.length);
                        var $tbody = $('#table-missing-' + key + ' tbody');
                        for (var j = 0; j < list.length; j++) {
                            var p = list[j];
                            $('<tr style="cursor:pointer" data-patient-id="' + p['id'] + '">')
                                .append('<td class="stat-cell">' + p['nom'] + '</td>')
                                .append('<td class="stat-cell">' + p['prenom'] + '</td>')
                                .append('<td class="stat-cell">' + p['ddn'] + '</td>')
                                .appendTo($tbody);
                        }
                    });
                }

                updateWidth();
            }
        });
    }
    ajaxAction();

    $("#update").click(function() {
        ajaxAction();
    })

    var $table = $('.box table'),
        $headCells = $('.box table:first thead tr').children(),
        headWidth;

    // Get the tbody columns width array
    headWidth = $headCells.map(function() {
        return $(this).data('width');
    }).get();

    function updateWidth() {
        $table.find('tbody tr').each(function(i, v) {
            $(v).children().each(function(j, s) {
                $(s).width(headWidth[j]);
            });
        });
    }

    // Clic sur un patient -> ouvrir sa fiche
    $(document).on('click', '[id^="table-missing-"] tbody tr', function() {
        var id = $(this).data('patient-id');
        if (id) {
            window.open("{{ path('patient_vue', {id: 0}) }}".replace('0', id), '_blank');
        }
    });
</script>
{% endblock %}
