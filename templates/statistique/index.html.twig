                            <div class="stats-number"></div>
                        </div>
                    </div>
                    <div class="stats">
                        <div>
                            <div class="stats-text">2.7 - Nombre total de séances collectives d'ETP réalisées</div>
                            <div class="stats-number"></div>
                        </div>
                    </div>
                    <div class="stats">
                        <div>
                            <div class="stats-text">2.7bis - Dont nombre de séances collectives d'ETP réalisées en distanciel</div>
                            <div class="stats-number"></div>
                        </div>
