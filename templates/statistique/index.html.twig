{% extends 'layout.html.twig' %}

{% block stylesheets %}
    <style>
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
{% endblock %}

{% block title %}Statistiques{% endblock %}

{% block page_content %}

<div class="wrapper">
    <h1>Statistiques</h1>

    <div class="btn-container">
        <div class="input-group input-daterange">
            <input type="text" class="form-control" id="dateDebut">
            <div class="input-group-addon">à</div>
            <input type="text" class="form-control" id="dateFin">
        </div>
        <button type="submit" class="btn btn-default" id="update">
            Mettre à jour
        </button>
        <span id="loading" style="display: none;">
            <svg width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" style="animation: spin 1s linear infinite;">
                <circle cx="10" cy="10" r="8" stroke="#999" stroke-width="2.5" fill="none" stroke-dasharray="40 20" stroke-linecap="round"/>
            </svg>
        </span>
    </div>

    <div class="aspect-wrapper">

        <div class="aspect-tab">
            <input id="item-1" type="checkbox" class="aspect-input" name="aspect">
            <label for="item-1" class="aspect-label"></label>
            <div class="aspect-content">
                <div class="aspect-info">
                    <span class="aspect-name">1. Entrée dans le programme</span>
                </div>
                <div class="aspect-stat"></div>
            </div>
            <div class="aspect-tab-content">
                <div class="stats-wrapper" id="entree">
                    <div class="stats">
                        <div>
                            <div class="stats-text">1.1 - Nombre de patients ayant bénéficié d'un diagnostic éducatif</div>
                            <div class="stats-number"></div>
                        </div>
                    </div>
                    <div class="stats">
                        <div>
                            <div class="stats-text">1.1bis - Dont nombre de patients ayant bénéficié d'un diagnostic éducatif en distanciel</div>
                            <div class="stats-number"></div>
                        </div>
                    </div>
                    <div class="stats">
                        <div>
                            <div class="stats-text">1.2 - Nombre de patients orientés par un professionnel de santé en dehors d'un hôpital (dont médecin traitant)</div>
                            <div class="stats-number"></div>
                        </div>
                    </div>
                    <div class="stats">
                        <div>
                            <div class="stats-text">1.3 - Nombre de patients orientés par un professionnel de santé au cours d'une hospitalisation</div>
                            <div class="stats-number"></div>
                        </div>
                    </div>
                    <div class="stats">
                        <div>
                            <div class="stats-text">1.4 - Nombre de patients orientés par un professionnel de santé à l'hôpital en consultation externe</div>
                            <div class="stats-number"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="aspect-tab">
            <input id="item-2" type="checkbox" class="aspect-input" name="aspect">
            <label for="item-2" class="aspect-label"></label>
            <div class="aspect-content">
                <div class="aspect-info">
                    <span class="aspect-name">2. Séances d'ETP et mode de prise en charge</span>
                </div>
                <div class="aspect-stat">

                </div>
            </div>
            <div class="aspect-tab-content">
                <div class="stats-wrapper" id="seance">
                    <div class="stats">
                        <div>
                            <div class="stats-text">2.1 - Nombre de patients pris en charge au cours d'une hospitalisation (de jour, de semaine, complète) en établissement de santé uniquement</div>
                            <div class="stats-number"></div>
                        </div>
                    </div>
                    <div class="stats">
                        <div>
                            <div class="stats-text">2.2 - Nombre de patients pris en charge en soins externes d'un établissement de santé uniquement (le patient vient à l'hôpital pour une séance d'ETP)</div>
