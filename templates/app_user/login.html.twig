{% extends 'layout_fos.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block user_content %}
    <div class="auth__head">
        <h2>Connexion</h2>
        <p>Utilisez l’identifiant fourni par l’équipe ETP.</p>
    </div>

    {% if error %}
        <div class="alert-msg alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form class="form-signin" action="{{ path('login') }}" method="post">
        <div class="form-group">
            <label for="inputUsername" class="form-control-label">Identifiant</label>
            <input type="text" id="inputUsername" name="_username" value="{{ last_username }}" class="form-control" required="required" autocomplete="username"{% if not last_username %} autofocus="autofocus"{% endif %}>
        </div>
        <div class="form-group">
            <label for="inputPassword" class="form-control-label">Mot de passe</label>
            <div class="password-field">
                <input type="password" id="inputPassword" name="_password" class="form-control" required="required" autocomplete="current-password"{% if last_username %} autofocus="autofocus"{% endif %}>
                <button type="button" class="password-field__toggle js-toggle-password" aria-controls="inputPassword" aria-pressed="false">Afficher</button>
            </div>
        </div>
        <label class="auth__remember" for="remember_me">
            <input id="remember_me" type="checkbox" name="_remember_me"> Rester connecté sur ce poste
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn btn-block btn-primary btn-lg">Se connecter</button>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-block btn-default" href="{{ path('register') }}">Créer un compte</a>
        {% endif %}
    </form>
{% endblock user_content %}

{% block javascripts %}
    <script>
        $('.js-toggle-password').on('click', function () {
            const input = $('#inputPassword');
            const show = input.attr('type') === 'password';
            input.attr('type', show ? 'text' : 'password');
            $(this).text(show ? 'Masquer' : 'Afficher').attr('aria-pressed', show);
        });
    </script>
{% endblock %}
