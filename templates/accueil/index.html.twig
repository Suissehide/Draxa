{% extends 'layout.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/select2.min.css') }}">
{% endblock %}

{% block title %}Agenda{% endblock %}

{% set categories = [
    {'key': 'consultations', 'cat': 'Consultation', 'label': 'Consultations', 'short': 'Consultation', 'empty': 'Aucune consultation ce jour'},
    {'key': 'entretiens', 'cat': 'Entretien', 'label': 'Entretiens individuels', 'short': 'Entretien', 'empty': 'Aucun entretien ce jour'},
    {'key': 'coachings', 'cat': 'Coaching', 'label': 'Coachings PRM', 'short': 'Coaching PRM', 'empty': 'Aucun coaching PRM ce jour'},
    {'key': 'ateliers', 'cat': 'Atelier', 'label': 'Ateliers', 'short': 'Atelier', 'empty': 'Aucun atelier ce jour'},
    {'key': 'educatives', 'cat': 'Educative', 'label': 'Semaines éducatives', 'short': 'Semaine éducative', 'empty': 'Aucune semaine éducative ce jour'}
] %}

{% block page_content %}
    <div class="page agenda">

        {# Barre des jours : un clic par jour #}
        <div class="agenda__bar">
            <h1 class="page-title">Agenda du jour</h1>
            <div class="daybar">
                <button type="button" class="daybar__nav js-week-prev" aria-label="Semaine précédente">{{ icons.icon('chevron-left') }}</button>
                <div class="daybar__days js-days" role="group" aria-label="Jours de la semaine"></div>
                <button type="button" class="daybar__nav js-week-next" aria-label="Semaine suivante">{{ icons.icon('chevron-right') }}</button>
                <span class="daybar__sep" aria-hidden="true"></span>
                <label class="daybar__picker" title="Choisir une date">
                    <span class="sr-only">Choisir une date</span>
                    {{ icons.icon('calendar') }}
                    <input type="text" id="dayPicker" readonly>
                </label>
                <button type="button" class="btn btn-soft js-today">Aujourd’hui</button>
            </div>
        </div>
        <p class="agenda__date js-day-label" aria-live="polite"></p>

        {# Filtres : cases colorées + légende #}
        <div class="agenda__filters">
            <div class="checkrow" role="group" aria-label="Catégories affichées">
                {% for c in categories %}
                    <label class="check check--{{ c.cat|lower }}">
                        <input type="checkbox" class="js-section-filter" value="{{ c.key }}" checked>
                        <span class="check__box" aria-hidden="true"></span>
                        {{ c.short }} <span class="check__count js-count-{{ c.key }}"></span>
                    </label>
                {% endfor %}
            </div>
            <div class="legend">
                <span class="presence presence--oui presence--static"><i></i>Venu</span>
                <span class="presence presence--non presence--static"><i></i>Absent</span>
                <span class="presence presence--static"><i></i>Non renseigné</span>
                <span class="tag tag--tf">TF</span> Theraflow
                <span class="tag tag--aomi">AOMI</span> ViVa module AOMI
            </div>
        </div>


        {# Créneaux du jour #}
        <div class="accueil-wrapper">
            {% for c in categories %}
                <section class="slots box" id="{{ c.key }}" data-anchor="{{ c.key }}" data-index="{{ loop.index0 }}">
                    <button type="button" class="slots__head cat--{{ c.cat|lower }}" aria-expanded="true">
                        <span class="cat-square" aria-hidden="true"></span>
                        <h2>{{ c.label }}</h2>
                        <span class="slots__summary js-summary"></span>
                        <span class="slots__chev" aria-hidden="true">{{ icons.icon('chevron-up', 16) }}</span>
                    </button>
                    <div class="slots__body">
                        <div class="slots__scroll">
                            <div class="slots__grid">
                                <div class="slot-row slot-row--head" aria-hidden="true">
                                    <span>Horaire</span><span>Thématique</span><span>Lieu</span><span>Soignant</span>
                                    <span class="pat-row pat-row--head"><span>Patients</span><span>Type</span><span>Présence</span><span>Courrier</span><span class="text-right">Actions</span></span>
                                </div>
                                <div class="js-slots" data-empty="{{ c.empty }}"></div>
                            </div>
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div>

        {# Recherche de créneaux #}
        <section class="card search-slots">
            <div class="search-slots__head">
                <h2>Rechercher un créneau</h2>
                <div class="input-group input-daterange">
                    <input type="text" class="form-control" id="dateDebut" aria-label="Du">
                    <div class="input-group-addon">à</div>
                    <input type="text" class="form-control" id="dateFin" aria-label="Au">
                </div>
                <div class="checkrow" role="group" aria-label="Catégories recherchées">
                    {% for c in categories %}
                        <label class="check check--{{ c.cat|lower }}">
                            <input type="checkbox" class="js-grid-filter" value="{{ c.cat }}" checked>
                            <span class="check__box" aria-hidden="true"></span>
                            {{ c.short }}
                        </label>
                    {% endfor %}
                </div>
            </div>
            <table id="rdv-grid" class="table table-condensed table-hover">
                <thead>
                <tr>
                    <th data-column-id="id" data-type="numeric" data-identifier="true" data-visible="false">ID</th>
                    <th data-column-id="categorie" data-width="40px" data-formatter="categorie" data-sortable="false"></th>
                    <th data-column-id="date" data-width="100px">Date</th>
                    <th data-column-id="horaire" data-width="122px" data-css-class="horaire">Horaire</th>
                    <th data-column-id="thematique" data-width="18%" data-css-class="thematique">Thématique</th>
                    <th data-column-id="location" data-width="11%">Lieu</th>
                    <th data-column-id="soignant" data-width="12%" data-sortable="false">Soignant</th>
                    <th data-column-id="patient" data-formatter="patient" data-sortable="false">Patients</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </section>
    </div>

    <!-- Modale : inscrire un patient au créneau -->
    <div id="addPatient" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="addPatientTitle">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">{{ icons.icon('close', 18) }}</button>
                    <h4 class="modal-title" id="addPatientTitle">Inscrire au créneau</h4>
                    <p class="modal-subtitle js-add-slot-label"></p>
                </div>
                <div class="modal-body">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}

                    {{ form_row(form.rendezVous) }}
                    <div class="modal-grid">
                        <div class="js-hide">
                            {{ form_row(form.thematique) }}
                        </div>
                        <div class="js-hide">
                            {{ form_row(form.type) }}
                        </div>
                    </div>
                    {{ form_row(form._token) }}
                    {{ form_end(form, {'render_rest' : false}) }}
                    <p class="text-danger js-modal-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                    <button type="button" id="patientAdd" class="btn btn-primary">Inscrire</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modale : note de transmission -->
    <div id="noteModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="noteModalTitle">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">{{ icons.icon('close', 18) }}</button>
                    <h4 class="modal-title" id="noteModalTitle">Note de transmission</h4>
                    <p class="modal-subtitle js-note-patient"></p>
                </div>
                <div class="modal-body">
                    <label for="noteText" class="sr-only">Note de transmission</label>
                    <textarea id="noteText" class="form-control" rows="4"></textarea>
                    <p class="text-danger js-note-error" role="alert" hidden></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-primary js-note-save">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/select2.min.js') }}"></script>
    <script src="{{ asset('js/select2-fr.js') }}"></script>

    <script>
        const thematiques = {{ thematiques|json_encode|raw }};
        const anchorList = ['consultations', 'entretiens', 'coachings', 'ateliers', 'educatives'];
        const categorieList = ['Consultation', 'Entretien', 'Coaching', 'Atelier', 'Educative'];
        const categorieLabels = {Consultation: 'Consultation', Entretien: 'Entretien', Coaching: 'Coaching PRM', Atelier: 'Atelier', Educative: 'Semaine éd.'};
        const presenceStates = {
            '': {label: 'À renseigner', cls: '', next: 'Oui'},
            'Oui': {label: 'Venu', cls: 'presence--oui', next: 'Non'},
            'Non': {label: 'Absent', cls: 'presence--non', next: ''}
        };
        const ICON = {
            edit: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z"/></svg>',
            close: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>',
            note: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4z"/></svg>',
            noteAdd: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H8l-4 4zM12 8v5M9.5 10.5h5"/></svg>'
        };

        moment.locale('fr');
        let selected = moment(localStorage.getItem('dateSelected') || moment().format('DD/MM/YYYY'), 'DD/MM/YYYY');
        if (!selected.isValid()) selected = moment();

        /* Barre des jours
        ============================================================================== */

        function renderDays() {
            const monday = selected.clone().startOf('isoWeek');
            const today = moment().format('DD/MM/YYYY');
            let html = '';
            for (let i = 0; i < 7; i++) {
                const d = monday.clone().add(i, 'days');
                const key = d.format('DD/MM/YYYY');
                const isSel = d.isSame(selected, 'day');
                html += '<button type="button" class="daybar__day' + (isSel ? ' is-selected' : '') + (key === today ? ' is-today' : '') + (i > 4 ? ' is-weekend' : '') + '" data-date="' + key + '"' + (isSel ? ' aria-current="date"' : '') + '>'
                    + '<span class="daybar__dow">' + d.format('ddd') + '</span> <span class="daybar__num">' + d.format('D') + '</span>'
                    + '</button>';
            }
            $('.js-days').html(html);
            const label = selected.format('dddd D MMMM YYYY');
            $('.js-day-label').text(label.charAt(0).toUpperCase() + label.slice(1));
        }

        function selectDate(m) {
            selected = m.clone();
            localStorage.setItem('dateSelected', selected.format('DD/MM/YYYY'));
            renderDays();
            ajaxAction(selected.format('DD/MM/YYYY'));
        }

        $('.js-days').on('click', '.daybar__day', function () { selectDate(moment($(this).data('date'), 'DD/MM/YYYY')); });
        $('.js-week-prev').on('click', function () { selectDate(selected.clone().subtract(7, 'days')); });
        $('.js-week-next').on('click', function () { selectDate(selected.clone().add(7, 'days')); });
        $('.js-today').on('click', function () { selectDate(moment()); });
        $('#dayPicker').datepicker({language: 'fr', format: 'dd/mm/yyyy', todayBtn: 'linked', todayHighlight: true, autoclose: true})
            .on('changeDate', function (e) { selectDate(moment(e.date)); });


        /* Filtres des sections (mémorisés) et repli
        ============================================================================== */

        const hidden = JSON.parse(localStorage.getItem('agendaHidden') || '[]');
        $('.js-section-filter').each(function () {
            if (hidden.indexOf(this.value) > -1) {
                this.checked = false;
                $('#' + this.value).hide();
            }
        }).on('change', function () {
            $('#' + this.value).toggle(this.checked);
            const list = $('.js-section-filter:not(:checked)').map(function () { return this.value; }).get();
            localStorage.setItem('agendaHidden', JSON.stringify(list));
        });

        $('.slots__head').on('click', function () {
            const section = $(this).closest('.slots');
            section.toggleClass('is-collapsed');
            $(this).attr('aria-expanded', !section.hasClass('is-collapsed'));
        });

        /* Chargement des créneaux du jour
        ============================================================================== */

        let ajaxActionSeq = 0;
        let dayData = [[], [], [], [], []];

        function setDayMessage(message) {
            $('.js-slots').html('<p class="slots__empty">' + escapeHtml(message) + '</p>');
        }

        function ajaxAction(d) {
            // On ignore les réponses d'un jour qui n'est plus sélectionné (clics rapides).
            const seq = ++ajaxActionSeq;
            setDayMessage('Chargement…');
            $.ajax({
                url: "{{ path('accueil') }}",
                type: "POST",
                dataType: "json",
                data: {"date": d},
                error: function () {
                    if (seq === ajaxActionSeq) setDayMessage('Impossible de charger les créneaux de ce jour. Rechargez la page.');
                },
                success: function (res) {
                    if (seq !== ajaxActionSeq) return;
                    dayData = res;
                    renderDay();
                }
            });
        }

        function slotKey(s) {
            // Tri par défaut : soignant puis horaire
            return (s.soignant || '').toLowerCase() + '|' + s.horaire;
        }

        function renderDay() {
            for (let i = 0; i < anchorList.length; i++) {
                const section = $('#' + anchorList[i]);
                const slots = (dayData[i] || []).slice().sort(function (a, b) { return slotKey(a).localeCompare(slotKey(b)); });
                const nbPatients = slots.reduce(function (n, s) { return n + s.patients.length; }, 0);
                section.toggleClass('is-empty', slots.length === 0);
                section.find('.js-summary').text(slots.length
                    ? slots.length + ' créneau' + (slots.length > 1 ? 'x' : '') + ' · ' + nbPatients + ' patient' + (nbPatients > 1 ? 's' : '')
                    : section.find('.js-slots').data('empty'));
                $('.js-count-' + anchorList[i]).text(slots.length || '');
                section.find('.js-slots').html(slots.map(renderSlot).join(''));
            }
        }

        function renderSlot(s) {
            const left = parseInt(s.place) - s.patients.length;
            const places = s.patients.length + ' / ' + s.place;
            let html = '<div class="slot-row" data-row-id="' + escapeHtml(s.id) + '" data-categorie="' + escapeHtml(s.categorie) + '" data-thematique="' + escapeHtml(s.thematique) + '" data-place="' + escapeHtml(s.place) + '">'
                + '<span class="slot-row__time">' + escapeHtml((s.horaire || '').split(' - ')[0]) + '<small>' + escapeHtml((s.horaire || '').split(' - ')[1] || '') + '</small></span>'
                + '<span class="slot-row__them thematique">' + escapeHtml(s.thematique) + '</span>'
                + '<span class="slot-row__muted">' + escapeHtml(s.location) + '</span>'
                + '<span class="slot-row__muted">' + escapeHtml(s.soignant) + '</span>'
                + '<div class="slot-row__patients">';
            s.patients.forEach(function (p) { html += renderPatient(p); });
            if (left > 0) {
                html += '<button type="button" class="link-btn js-addPatient">+ Inscrire un patient <span class="chip__muted">· ' + places + ' — ' + left + ' place' + (left > 1 ? 's' : '') + ' libre' + (left > 1 ? 's' : '') + '</span></button>';
            } else if (s.patients.length === 0) {
                html += '<span class="slot-row__full">Aucune place</span>';
            }
            return html + '</div></div>';
        }

        function renderPatient(p, compact) {
            const state = presenceStates[p.venu] || presenceStates[''];
            const name = escapeHtml(p.nom) + ' ' + escapeHtml(p.prenom);
            const note = p.notes
                ? '<button type="button" class="note-btn js-note" title="' + escapeHtml(p.notes) + '" aria-label="Modifier la note : ' + escapeHtml(p.notes) + '">' + ICON.note + '<span>' + escapeHtml(p.notes) + '</span></button>'
                : '<button type="button" class="icon-btn icon-btn--sm icon-btn--muted js-note" title="Ajouter une note" aria-label="Ajouter une note de transmission">' + ICON.noteAdd + '</button>';
            if (compact) {
                return '<div class="pat-row pat-row--compact" data-id="' + escapeHtml(p.rendezVousId) + '" data-patient="' + escapeHtml(p.patientId) + '" data-etat="' + escapeHtml(p.venu) + '" data-notes="' + escapeHtml(p.notes || '') + '">'
                    + '<span class="pat-row__name"><a href="#" class="js-redirect" data-id="' + escapeHtml(p.patientId) + '">' + name + '</a>'
                    + (p.theraflow ? '<span class="tag tag--tf" title="Theraflow">TF</span>' : '')
                    + (p.progetp === 'ViVa module AOMI' ? '<span class="tag tag--aomi" title="ViVa module AOMI">AOMI</span>' : '') + '</span>'
                    + '<span><button type="button" class="presence js-presence ' + state.cls + '" aria-label="Présence : ' + state.label + ' (cliquer pour changer)" title="Cliquer pour changer"><i></i>' + state.label + '</button></span>'
                    + '<span class="pat-row__actions"><button type="button" class="icon-btn icon-btn--danger js-removePatient" data-id="' + escapeHtml(p.patientId) + '" aria-label="Retirer ' + name + ' du rendez-vous" title="Retirer du rendez-vous">' + ICON.close + '</button></span></div>';
            }
            return '<div class="pat-row user-send" data-id="' + escapeHtml(p.rendezVousId) + '" data-patient="' + escapeHtml(p.patientId) + '" data-etat="' + escapeHtml(p.venu) + '" data-notes="' + escapeHtml(p.notes || '') + '">'
                + '<span class="pat-row__name"><a href="#" class="js-redirect" data-id="' + escapeHtml(p.patientId) + '">' + name + '</a>'
                + (p.theraflow ? '<span class="tag tag--tf" title="Theraflow">TF</span>' : '')
                + (p.progetp === 'ViVa module AOMI' ? '<span class="tag tag--aomi" title="ViVa module AOMI">AOMI</span>' : '')
                + note + '</span>'
                + '<span class="pat-row__type">' + escapeHtml(p.type) + '</span>'
                + '<span><button type="button" class="presence js-presence ' + state.cls + '" aria-label="Présence : ' + state.label + ' (cliquer pour changer)" title="Cliquer pour changer"><i></i>' + state.label + '</button></span>'
                + '<label class="pat-row__mail" title="Courrier envoyé"><input class="mail-cbx" type="checkbox" data-id="' + escapeHtml(p.rendezVousId) + '" ' + (p.send === 'Oui' ? 'checked' : '') + ' aria-label="Courrier envoyé"></label>'
                + '<span class="pat-row__actions">'
                + '<a href="#" class="icon-btn js-redirect" data-id="' + escapeHtml(p.patientId) + '" aria-label="Ouvrir la fiche de ' + name + '" title="Ouvrir la fiche">' + ICON.edit + '</a>'
                + '<button type="button" class="icon-btn icon-btn--danger js-removePatient" data-id="' + escapeHtml(p.patientId) + '" aria-label="Retirer ' + name + ' du rendez-vous" title="Retirer du rendez-vous">' + ICON.close + '</button>'
                + '</span></div>';
        }

        /* Actions sur un patient (agenda du jour et recherche)
        ============================================================================== */

        function anchorOf(el) {
            const cat = $(el).closest('[data-categorie]').data('categorie');
            return anchorList[categorieList.indexOf(cat)] || '';
        }

        function reloadAll() {
            ajaxAction(selected.format('DD/MM/YYYY'));
            $("#rdv-grid").bootgrid('reload');
        }

        // Présence en un clic : À renseigner → Venu → Absent → À renseigner
        $(document).on('click', '.js-presence', function () {
            const row = $(this).closest('.pat-row');
            const next = (presenceStates[row.attr('data-etat')] || presenceStates['']).next;
            const button = $(this).prop('disabled', true);
            $.ajax({
                url: "{{ path('rendezVous_etat') }}",
                type: 'POST',
                dataType: 'json',
                data: {id: row.data('id'), etat: next},
                success: function () {
                    // Met à jour toutes les lignes de ce rendez-vous (agenda du jour et recherche de créneaux)
                    const state = presenceStates[next];
                    $('.pat-row[data-id="' + row.data('id') + '"]').each(function () {
                        $(this).attr('data-etat', next).find('.js-presence')
                            .removeClass('presence--oui presence--non').addClass(state.cls)
                            .attr('aria-label', 'Présence : ' + state.label + ' (cliquer pour changer)')
                            .html('<i></i>' + state.label);
                    });
                },
                complete: function () { button.prop('disabled', false); }
            });
        });

        // Courrier envoyé
        $(document).on('change', '.pat-row .mail-cbx', function () {
            $.ajax({
                url: "{{ path('rendezVous_send') }}",
                type: "POST",
                dataType: "json",
                data: {id: $(this).data('id'), send: this.checked ? 'Oui' : 'Non'}
            });
        });

        // Note de transmission
        let noteRow = null;
        $(document).on('click', '.js-note', function () {
            noteRow = $(this).closest('.pat-row');
            $('.js-note-patient').text(noteRow.find('.pat-row__name a').text());
            $('#noteText').val(noteRow.attr('data-notes'));
            $('.js-note-error').prop('hidden', true);
            $('#noteModal').modal('show');
        });
        $('#noteModal').on('shown.bs.modal', function () { $('#noteText').trigger('focus'); });
        $('.js-note-save').on('click', function () {
            const button = $(this).prop('disabled', true);
            $.ajax({
                url: "{{ path('rendezVous_notes') }}",
                type: 'POST',
                dataType: 'json',
                data: {id: noteRow.data('id'), notes: $('#noteText').val()},
                success: function () {
                    $('#noteModal').modal('hide');
                    reloadAll();
                    successAlert('Note enregistrée.');
                },
                error: function () { $('.js-note-error').text('La note n\'a pas été enregistrée. Réessayez.').prop('hidden', false); },
                complete: function () { button.prop('disabled', false); }
            });
        });

        // Ouvrir la fiche du patient, positionnée sur la bonne catégorie
        $(document).on('click', '.js-redirect', function (e) {
            e.preventDefault();
            redirectToPatient($(this).data('id'), anchorOf(this));
        });

        function redirectToPatient(patientId, anchor) {
            $.ajax({
                url: "{{ path('redirect_vue_patient') }}",
                type: "POST",
                dataType: "json",
                data: {id: patientId, anchor: anchor},
                success: function (res) { window.location.href = res; }
            });
        }

        // Retirer du rendez-vous
        $(document).on('click', '.js-removePatient', function () {
            const patientId = $(this).data('id');
            const anchor = anchorOf(this);
            const rendezVousId = $(this).closest('.pat-row').data('id');
            const slotId = $(this).closest('[data-row-id]').data('row-id');
            const name = $(this).closest('.pat-row').find('.pat-row__name a').text();
            confirmAction({
                title: 'Retirer ' + name + ' ?',
                message: 'Son rendez-vous sera supprimé de sa fiche.',
                confirmLabel: 'Retirer',
                onConfirm: function () {
                    $.ajax({
                        url: "{{ path('remove_patient_slot') }}",
                        type: "POST",
                        dataType: "json",
                        data: {rendezVousId: rendezVousId, slotId: slotId},
                        success: function () {
                            reloadAll();
                            successAlert('Patient retiré du rendez-vous.');
                            redirectToPatient(patientId, anchor);
                        }
                    });
                }
            });
        });

        // Inscrire un patient
        $(".js-patient").select2({
            multiple: false,
            dropdownParent: $('#addPatient'),
            width: '100%',
            matcher: function (params, data) {
                if ($.trim(params.term) === '') return data;
                if (typeof data.text === 'undefined') return null;
                return data.text.toLowerCase().indexOf(params.term.toLowerCase()) > -1 ? $.extend({}, data, true) : null;
            }
        });

        $(document).on('click', '.js-addPatient', function () {
            const row = $(this).closest('[data-row-id]');
            const index = categorieList.indexOf(row.data('categorie'));
            $('#patientAdd').attr('data-id', row.data('row-id'));
            $('.js-add-slot-label').text(categorieLabels[row.data('categorie')] + ' · ' + row.find('.thematique').first().text());
            $('.js-hide').toggle(index !== 4);

            $('#add_patient_thematique').empty().append('<option value=""></option>');
            $.each(thematiques[index] || [], function (key, value) {
                $('#add_patient_thematique').append($("<option></option>").attr("value", value).text(value));
            });
            $('#add_patient_thematique option').filter(function () { return this.value === String(row.data('thematique')); }).prop('selected', true);
            $('#add_patient_type option[value=""]').prop('selected', true);
            $('#addPatient .js-modal-error').prop('hidden', true);
            $('#addPatient').modal('show');
        });
        $('#addPatient').on('shown.bs.modal', function () { $('.js-patient').select2('open'); });

        $('#patientAdd').on('click', function () {
            const button = $(this);
            const modalError = $('#addPatient .js-modal-error');
            const patientId = $('#add_patient_rendezVous').val();
            // La modale reste ouverte tant que l'ajout n'a pas réussi, pour pouvoir corriger.
            if (!patientId) {
                modalError.text('Choisissez un patient.').prop('hidden', false);
                return;
            }
            button.prop('disabled', true);
            $.ajax({
                url: "{{ path('add_patient_slot') }}",
                type: "POST",
                dataType: "json",
                data: {
                    patientId: patientId,
                    slotId: button.attr('data-id'),
                    thematique: $('#add_patient_thematique').val(),
                    type: $('#add_patient_type').val()
                },
                success: function (res) {
                    if (res) {
                        $('#addPatient').modal('hide');
                        reloadAll();
                        successAlert('Patient inscrit au créneau.');
                    } else {
                        modalError.text('Ce patient est déjà inscrit à ce créneau.').prop('hidden', false);
                    }
                },
                error: function () {
                    modalError.text('L\'inscription n\'a pas été enregistrée. Réessayez ou rechargez la page.').prop('hidden', false);
                },
                complete: function () { button.prop('disabled', false); }
            });
        });

        /* Recherche de créneaux
        ============================================================================== */

        $('.input-daterange').datepicker({language: 'fr', format: 'dd/mm/yyyy', todayBtn: true, todayHighlight: false, autoclose: false});
        $('#dateDebut').datepicker('setDate', new Date());
        $('#dateFin').datepicker('setDate', moment().endOf('year').format('DD/MM/YYYY'));
        $('.input-daterange input').datepicker('update');

        let categories = categorieList.slice();
        $('.js-grid-filter').on('change', function () {
            categories = $('.js-grid-filter:checked').map(function () { return this.value; }).get();
            $("#rdv-grid").bootgrid('reload');
        });
        $('.input-daterange input').on('changeDate', function () {
            $('.input-daterange').datepicker('update');
            $("#rdv-grid").bootgrid('reload');
        });

        $("#rdv-grid").bootgrid({
            rowCount: [25, 50, -1],
            columnSelection: false,
            ajax: true,
            ajaxSettings: {method: "POST", cache: false},
            post: function () {
                // Aucune case cochée : on n'affiche rien plutôt que tout
                return {categories: categories.length ? categories : ['-'], dateDebut: $('#dateDebut').val(), dateFin: $('#dateFin').val()};
            },
            url: "{{ path('slot_list') }}",
            labels: {
                all: 'Tous', infos: '{{ '{{' }}ctx.start{{ '}}' }}–{{ '{{' }}ctx.end{{ '}}' }} sur {{ '{{' }}ctx.total{{ '}}' }} créneaux',
                loading: 'Chargement…', noResults: 'Aucun créneau sur cette période', refresh: 'Actualiser', search: 'Rechercher'
            },
            formatters: {
                "categorie": function (column, row) {
                    return '<span class="cat-dot cat-dot--' + String(row.categorie).toLowerCase() + '" title="' + escapeHtml(categorieLabels[row.categorie] || row.categorie) + '"></span>';
                },
                "patient": function (column, row) {
                    let html = '<div class="grid-patients" data-row-id="' + escapeHtml(row.id) + '" data-categorie="' + escapeHtml(row.categorie) + '" data-thematique="' + escapeHtml(row.thematique) + '"><span class="thematique" hidden>' + escapeHtml(row.thematique) + '</span>';
                    row.patients.forEach(function (p) { html += renderPatient(p, true); });
                    const left = parseInt(row.place) - row.patients.length;
                    if (left > 0) html += '<button type="button" class="link-btn js-addPatient">+ Inscrire <span class="chip__muted">· ' + row.patients.length + ' / ' + row.place + '</span></button>';
                    return html + '</div>';
                }
            }
        });

        renderDays();
        ajaxAction(selected.format('DD/MM/YYYY'));
    </script>
{% endblock %}
