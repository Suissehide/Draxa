{% block todo %}

    <div class="todo__scrim" hidden></div>
    <aside class="todo__container" id="todo-panel" role="dialog" aria-modal="false" aria-labelledby="todo-title" hidden>
        <div class="todo__content">
            <div class="todo__header">
                <div class="todo__title">
                    <h2 id="todo-title">Tâches</h2>
                    <p class="todo__flex"><span class="todo__task-count">0 tâche</span> · <span class="todo__date">01/01/2022</span></p>
                </div>
                <button type="button" class="close" aria-label="Fermer les tâches">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
            </div>
            <div class="input__flex">
                <label for="todo__add" class="sr-only">Nouvelle tâche</label>
                <input type="text" id="todo__add" name="todo__add" required="required" class="form-control" placeholder="Saisissez une tâche puis Entrée…">
                <button type="button" class="btn btn-primary todo__add">Ajouter</button>
            </div>
            <div class="todo__filters" role="tablist" aria-label="Filtrer les tâches">
                <button type="button" role="tab" class="todo__filter is-active" data-filter="todo" aria-selected="true">À faire <span class="js-count-todo">0</span></button>
                <button type="button" role="tab" class="todo__filter" data-filter="done" aria-selected="false">Terminées <span class="js-count-done">0</span></button>
                <button type="button" role="tab" class="todo__filter" data-filter="all" aria-selected="false">Toutes</button>
            </div>
            <div class="todo__tasks">
                <ul class="todo__list" data-filter="todo"></ul>
                <p class="todo__empty" hidden>Aucune tâche ici.</p>
            </div>
            <div class="todo__footer">
                <button type="button" class="btn btn-danger-outline todo__clear">Vider la liste</button>
            </div>
        </div>
    </aside>

{% endblock %}

{% block todo_javascripts %}

    <script type="text/javascript">
        // Panneau latéral des tâches : s'ouvre depuis le bouton en haut du menu.
        let open = false;

        function setTodoOpen(value) {
            open = value;
            $('.todo__container, .todo__scrim').prop('hidden', !open);
            $('#todo-list').attr('aria-expanded', open).toggleClass('is-active', open);
            if (open) $('#todo__add').trigger('focus');
        }

        $('#todo-list').on('click', function () { setTodoOpen(!open); });
        $('.todo__content .close, .todo__scrim').on('click', function () { setTodoOpen(false); });
        $(document).on('keydown', function (e) {
            if (open && e.key === 'Escape') setTodoOpen(false);
        });

        // Filtre À faire / Terminées / Toutes (côté navigateur)
        $('.todo__filter').on('click', function () {
            $('.todo__filter').removeClass('is-active').attr('aria-selected', 'false');
            $(this).addClass('is-active').attr('aria-selected', 'true');
            $('.todo__list').attr('data-filter', $(this).data('filter'));
            updateTodoOffset();
        });

        // Compteurs des filtres et message « liste vide »
        function updateTodoOffset() {
            const done = $('.todo__list > li .inp-cbx:checked').length;
            const todo = $('.todo__list > li').length - done;
            $('.js-count-todo').text(todo);
            $('.js-count-done').text(done);
            const filter = $('.todo__list').attr('data-filter');
            const visible = filter === 'all' ? todo + done : (filter === 'done' ? done : todo);
            $('.todo__empty').prop('hidden', visible > 0);
        }

        var tasksNb = 0

        function loadTodos() {
            $.ajax({
                url: "{{ path('todo_get') }}",
                type: "GET",
                dataType: "json",
                success: function (resp) {
                    if (resp) {
                        tasksNb = Object.keys(resp).length;
                        setTaskNumber();
                        setTaskNotification();
                        $.each(resp, function(i, obj) {
                            let split = obj.datetime.split(' ');
                            let new_date = new Date(split[0].split('/')[2], split[0].split('/')[1] - 1, split[0].split('/')[0], split[1].split(':')[0], split[1].split(':')[1]);
                            let date_task = new Intl.DateTimeFormat("fr-FR", { month: 'long', day: 'numeric', hour: 'numeric', minute: 'numeric' }).format(new_date);
                            let enable = obj.enable ? 'checked' : '';
                            let task = `
                            <li data-id="` + escapeHtml(obj.id) + `">
                                <div class="form-check">
                                    <input class="inp-cbx" id="task_` + escapeHtml(obj.id) + `" type="checkbox" ` + enable + `/>
                                    <label class="cbx" for="task_` + escapeHtml(obj.id) + `"></label>
                                    <span class="todo__action" contenteditable="true">` + escapeHtml(obj.description) + `</span>
                                </div>
                                <div class="todo__button-bar">
                                    <div class="todo__time">` + date_task + `</div>
                                    <button type="button" class="todo__delete" aria-label="Supprimer la tâche" title="Supprimer la tâche"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7h14M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button>
                                </div>
                            </li>`
                            $(".todo__list").append(task);
                        });
                        setTaskNotification();
                        updateTodoOffset();
                        updateTodoOffset();
                    } else {
                        errorAlert('Impossible de récupérer la liste des tâches.');
                    }
                }
            })
        }

        function setTodoDate() {
            let today = new Date();
            var options = {
                year: "numeric",
                month: "2-digit",
                day: "numeric"
            };
            let date = new Intl.DateTimeFormat("fr-FR", options).format(today);

            $('.todo__date').text(date);
        }

        loadTodos();
        setTodoDate();

        function setTaskNumber() {
            $('.todo__task-count').text(tasksNb + ((tasksNb > 1) ? ' tâches' : ' tâche'));
        }

        // Le badge ne compte que les tâches restant à faire (non cochées)
        function setTaskNotification() {
            const todo = $('.todo__list > li .inp-cbx:not(:checked)').length;
            $('.todo__notification').text((todo > 9) ? '9+' : todo).toggle(todo > 0);
        }

        /***** ADD *****/
        $('#todo__add').bind("enterKey",function(e){
            addTask();
        });

        $('#todo__add').keyup(function(e){
            if(e.keyCode === 13) $(this).trigger("enterKey");
        });

        $('.todo__add').click(function() {
            addTask();
        });


        function addTask() {
            let today = new Date();
            let time = new Intl.DateTimeFormat("fr-FR", { month: 'long', day: 'numeric', hour: 'numeric', minute: 'numeric' }).format(today);
            let text = $('#todo__add').val();
            if (!$.trim(text)) return;

            $('#todo__add').val('');

            $.ajax({
                url: "{{ path('todo_add') }}",
                type: "POST",
                dataType: "json",
                data: {
                    description: text
                },
                success: function (id) {
                    if (id) {
                        let task = `
                        <li data-id="` + escapeHtml(id) + `">
                            <div class="form-check">
                                <input class="inp-cbx" id="task_` + escapeHtml(id) + `" type="checkbox"/>
                                <label class="cbx" for="task_` + escapeHtml(id) + `"></label>
                                <span class="todo__action" contenteditable="true">` + escapeHtml(text) + `</span>
                            </div>
                            <div class="todo__button-bar">
                                <div class="todo__time">` + time + `</div>
                                <button type="button" class="todo__delete" aria-label="Supprimer la tâche" title="Supprimer la tâche"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7h14M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button>
                            </div>
                        </li>`
                        $(".todo__list").append(task);
                        updateTodoOffset();

                        tasksNb += 1;
                        setTaskNumber();
                        setTaskNotification();
                    } else {
                        errorAlert('Impossible d\'ajouter la tâche.');
                    }
                }
            })
        }

        /***** REMOVE *****/
        $('.todo__list').on('click', '.todo__delete', function() {
            let id = $(this).parents('li').attr('data-id');
            removeTask(id);
        })

        function removeTask(taskId) {
            $.ajax({
                url: "{{ path('todo_remove') }}",
                type: "POST",
                dataType: "json",
                data: {
                    taskId: taskId,
                },
                success: function (resp) {
                    if (resp) {
                        tasksNb -= 1;
                        setTaskNumber();
                        setTaskNotification();
                        $('li[data-id=' + taskId +']').remove();
                        updateTodoOffset();
                        setTaskNotification();
                    } else {
                        errorAlert('Impossible de supprimer cette tâche.');
                    }
                }
            })
        }

        $('.todo__clear').on('click', function() {
            confirmAction({
                message: 'Supprimer toutes les tâches de la liste ?',
                confirmLabel: 'Vider la liste',
                onConfirm: function () {
                    $.ajax({
                        url: "{{ path('todo_clear') }}",
                        type: "POST",
                        dataType: "json",
                        data: {},
                        success: function (resp) {
                            if (resp) {
                                tasksNb = 0;
                                setTaskNumber();
                                setTaskNotification();
                                $('.todo__list > li').remove();
                                updateTodoOffset();
                            } else {
                                errorAlert('Impossible de vider la liste des tâches.');
                            }
                        }
                    })
                }
            });
        });

        $('.todo__list').on('change', '.form-check input', function() {
            let taskId = $(this).parents('li').attr('data-id');
            let enable = $(this).is(':checked');

            $.ajax({
                url: "{{ path('todo_enable') }}",
                type: "POST",
                dataType: "json",
                data: {
                    taskId: taskId,
                    enable: enable
                },
                success: function (resp) {
                    if (resp) {
                        setTaskNotification();
                        updateTodoOffset();
                    } else {
                        errorAlert('Impossible de changer l\'état de la tâche.');
                    }
                }
            })
        });

        // Enregistre le texte 600 ms après la dernière frappe (ou en quittant le champ) au lieu d'une requête par touche.
        const editTimers = {};

        function saveTask(span) {
            let taskId = $(span).parents('li').attr('data-id');
            let description = $(span).text();
            clearTimeout(editTimers[taskId]);
            delete editTimers[taskId];

                $.ajax({
                    url: "{{ path('todo_edit') }}",
                    type: "POST",
                    dataType: "json",
                    data: {
                        taskId: taskId,
                        description: description
                    },
                    success: function (resp) {
                        if (resp) {
                            return;
                        } else {
                            errorAlert('Impossible d\'enregistrer la tâche.');
                        }
                    }
                })
        }

        $('.todo__list').on('keyup', '.form-check .todo__action', function() {
            const span = this;
            const taskId = $(span).parents('li').attr('data-id');
            clearTimeout(editTimers[taskId]);
            editTimers[taskId] = setTimeout(function () { saveTask(span); }, 600);
        }).on('blur', '.form-check .todo__action', function() {
            if (editTimers[$(this).parents('li').attr('data-id')]) {
                saveTask(this);
            }
        });



        function formatDate(input) {
            let datePart = input.match(/\d+/g),
                year = datePart[2] //.substring(2),  get only two digits
                month = datePart[1],
                day = datePart[0];
            return year + '-' + month + '-' + day;
        }
    </script>

{% endblock %}
