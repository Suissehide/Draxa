{% extends 'layout.html.twig' %}

{% block stylesheets %}
{% endblock %}

{% block title %}Soignants{% endblock %}

{% block page_content %}
    <div class="page soignants-page">
        <div class="page-head">
            <div>
                <h1 class="page-title">Soignants</h1>
                <p class="page-head__hint">Les soignants actifs apparaissent dans les listes de créneaux, dans l’ordre ci-dessous. Cliquez sur un ou plusieurs noms pour les sélectionner, puis déplacez-les avec les flèches.</p>
            </div>
            <div class="page-head__actions">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#soignantModal">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    Ajouter un soignant
                </button>
            </div>
        </div>

        <div class="soignant__wrapper">
            <div id="actif" class="list-soignant">
                <h2>Actifs <span class="list-soignant__count js-count-actif">{{ soignants|filter(s => s.status == true)|length }}</span></h2>
                <ul>
                    {% for soignant in soignants|sort((a, b) => a.priority <=> b.priority) %}
                        {% if soignant.status == true %}
                            <li class="soignant" data-id="{{ soignant.id }}" tabindex="0" role="button" aria-pressed="false">
                                {{ soignant.prenom }} {{ soignant.nom }}
                                <button type="button" class="moveup-btn" aria-label="Monter dans la liste" title="Monter dans la liste"><span
                                            class="glyphicon glyphicon-chevron-up"></span></button>
                                <button type="button" class="remove-btn" aria-label="Supprimer ce soignant" title="Supprimer ce soignant"><span
                                            class="glyphicon glyphicon-remove"></span>
                                </button>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>

            <div class="soignant__btn-bar">
                <button type="button" disabled class="btn btn-default js-remove" title="Rendre inactifs les soignants sélectionnés">Désactiver <span class="glyphicon glyphicon-chevron-right"></span></button>
                <button type="button" disabled class="btn btn-default js-add" title="Rendre actifs les soignants sélectionnés"><span class="glyphicon glyphicon-chevron-left"></span> Réactiver</button>
            </div>

            <div id="inactif" class="list-soignant">
                <h2>Inactifs <span class="list-soignant__count js-count-inactif">{{ soignants|filter(s => s.status == false)|length }}</span></h2>
                <ul>
                    {% for soignant in soignants %}
                        {% if soignant.status == false %}
                            <li class="soignant" data-id="{{ soignant.id }}" tabindex="0" role="button" aria-pressed="false">
                                {{ soignant.prenom }} {{ soignant.nom }}
                                <button type="button" class="moveup-btn" style="display: none" aria-label="Monter dans la liste" title="Monter dans la liste">
                                    <span class="glyphicon glyphicon-chevron-up"></span>
                                </button>
                                <button type="button" class="remove-btn" aria-label="Supprimer ce soignant" title="Supprimer ce soignant">
                                    <span class="glyphicon glyphicon-remove"></span>
                                </button>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>

    </div>

    <!-- Modal addSoignant -->
    <div id="soignantModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Fermer">&times;</button>
                    <h4 class="modal-title">Ajouter un soignant</h4>
                </div>
                <div class="modal-body">
                    {{ form_start(soignantForm) }}
                    {{ form_errors(soignantForm) }}
                    {{ form_row(soignantForm.prenom) }}
                    {{ form_row(soignantForm.nom) }}

                    {{ form_row(soignantForm._token) }}
                    {{ form_end(soignantForm, {'render_rest' : false}) }}
                    <p class="text-danger js-modal-error" role="alert" hidden></p>
                    <button type="button" id="soignant_add" class="btn btn-primary btn-block">Ajouter</button>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-default pull-left" data-dismiss="modal">
                        <span class="glyphicon glyphicon-remove"></span>
                        Annuler
                    </button>
                </div>
            </div>
        </div>
    </div>

{% endblock page_content %}

{% block javascripts %}

    <script type="text/javascript">

        $('.list-soignant .soignant:first-child .moveup-btn').hide();

        $('#actif').on('click', '.moveup-btn', function (e) {
            e.stopPropagation();
            let index = ($(this).parent()).index()
            $(this).parent().insertBefore('#actif li:eq(' + (index - 1) + ')');

            $.ajax({
                url: "{{ path('status_priority_swap') }}",
                type: "POST",
                dataType: "json",
                data: {
                    "soignant1": $('#actif li:eq(' + (index - 1) + ')').attr('data-id'),
                    "soignant2": $('#actif li:eq(' + index + ')').attr('data-id'),
                },
                success: function (resp) {
                    if (resp) {
                        $('#actif .soignant .moveup-btn').show();
                        $('#actif .soignant:first-child .moveup-btn').hide();
                    } else {
                        errorAlert();
                    }
                }
            });
        });


        /* */

        $('.list-soignant').on('click', '.soignant', function (e) {
            $(this).toggleClass('selected').attr('aria-pressed', $(this).hasClass('selected') ? 'true' : 'false');
            updateTransfertButtons();
        }).on('keydown', '.soignant', function (e) {
            if ((e.key === 'Enter' || e.key === ' ') && e.target === this) {
                e.preventDefault();
                $(this).trigger('click');
            }
        });

        function updateTransfertButtons() {
            if ($('#inactif .soignant.selected').length > 0)
                toggleButton($('.js-add'), true);
            else
                toggleButton($('.js-add'), false);

            if ($('#actif .soignant.selected').length > 0)
                toggleButton($('.js-remove'), true);
            else
                toggleButton($('.js-remove'), false);
        }

        function toggleButton(obj, bool) {
            if (bool) {
                obj.prop("disabled", false);
                obj.addClass('active');
            } else {
                obj.prop("disabled", true);
                obj.removeClass('active');
            }
        }

        $('.js-add').click(function () {
            soignantUpdate(true);
        });

        $('.js-remove').click(function () {
            soignantUpdate(false);
        });

        function soignantUpdate(status) {
            let soignants = [];

            if (status) {
                $('#inactif .soignant.selected').each(function () {
                    soignants.push($(this).data('id'));
                });
            } else {
                $('#actif .soignant.selected').each(function () {
                    soignants.push($(this).data('id'));
                });
            }

            $.ajax({
                url: "{{ path('status_update') }}",
                type: "POST",
                dataType: "json",
                data: {
                    "soignants": soignants,
                    "status": status,
                },
                success: function (resp) {
                    if (resp) {
                        if (status) {
                            $('#inactif li.soignant.selected .moveup-btn').show();
                            $('#inactif li.soignant.selected').appendTo('#actif ul');
                        } else {
                            $('#actif li.soignant.selected .moveup-btn').hide();
                            $('#actif li.soignant.selected').appendTo('#inactif ul');
                        }
                        $('.soignant.selected').removeClass('selected').attr('aria-pressed', 'false');
                        updateTransfertButtons();
                    } else {
                        errorAlert();
                    }
                }
            });
        }


        $('#soignant_add').click(function () {
            var nom = $('#soignant_nom').val();
            var prenom = $('#soignant_prenom').val();
            const button = $(this);
            const modalError = $('#soignantModal .js-modal-error');

            // La modale reste ouverte tant que l'ajout n'a pas réussi, pour pouvoir corriger.
            if (!nom.trim() || !prenom.trim()) {
                modalError.text('Renseignez le prénom et le nom.').prop('hidden', false);
                return;
            }
            modalError.prop('hidden', true);
            button.prop('disabled', true);

            $.ajax({
                url: "{{ path('soignant_add') }}",
                type: "POST",
                dataType: "json",
                data: {
                    "nom": nom,
                    "prenom": prenom,
                },
                success: function (resp) {
                    if (resp) {
                        $('#actif ul')
                            .append(`<li class="soignant" data-id="` + escapeHtml(resp) + `" tabindex="0" role="button" aria-pressed="false">` + escapeHtml(prenom) + ' ' + escapeHtml(nom) + `<button type="button" class="moveup-btn" aria-label="Monter dans la liste" title="Monter dans la liste"><span class="glyphicon glyphicon-chevron-up"></span></button><button type="button" class="remove-btn" aria-label="Supprimer ce soignant" title="Supprimer ce soignant"><span class="glyphicon glyphicon-remove"></span></button></li>`);
                        $('#soignant_nom, #soignant_prenom').val('');
                        $('#soignantModal').modal('hide');
                    } else {
                        modalError.text('Impossible d\'ajouter ce soignant.').prop('hidden', false);
                    }
                },
                error: function () {
                    modalError.text('L\'ajout n\'a pas été enregistré. Réessayez ou rechargez la page.').prop('hidden', false);
                },
                complete: function () {
                    button.prop('disabled', false);
                }
            });
        });

        $('.list-soignant').on('click', '.remove-btn', function (e) {
            e.stopPropagation();
            let soignant = $(this).parents('.soignant');
            let id = soignant.data('id');
            confirmAction({
                message: 'Supprimer définitivement « ' + soignant.text().trim() + ' » ?',
                onConfirm: function () {
                    let url = "{{ path('soignant_delete', { 'id': 'soignant_id' }) }}";
                    url = url.replace("soignant_id", id);
                    $.ajax({
                        url: url,
                        type: "DELETE",
                        dataType: "json",
                        data: {},
                        success: function (resp) {
                            if (resp) {
                                soignant.remove();
                            } else {
                                errorAlert('Impossible de supprimer ce soignant.');
                            }
                        }
                    });
                }
            });
        });





        // Compteurs Actifs / Inactifs, tenus à jour à chaque déplacement, ajout ou suppression
        function updateSoignantCounts() {
            $('.js-count-actif').text($('#actif li.soignant').length);
            $('.js-count-inactif').text($('#inactif li.soignant').length);
        }
        new MutationObserver(updateSoignantCounts).observe(document.querySelector('.soignant__wrapper'), {childList: true, subtree: true});
    </script>

{% endblock %}