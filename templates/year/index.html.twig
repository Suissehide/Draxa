{% extends 'layout.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/js-year-calendar.min.css') }}">
{% endblock %}

{% block title %}Calendrier des années{% endblock %}

{% block page_content %}
    <div class="wrapper">
        <h1>Calendrier des années</h1>
        <div class="legende">
            <div class="legende__type">Légende :</div>
            <div class="legende__type">
                <span class="legende__color" style="background-color: var(--brand)"></span>
                Semaine programmée avec des créneaux
            </div>
            <div class="legende__type">
                <span class="legende__color" style="background-color: orange"></span>
                Semaine créée sans créneau
            </div>
            <div class="legende__type">
                <span class="legende__color legende__color--today"></span>
                Aujourd'hui
            </div>
        </div>
    </div>
	<div class="calendar"></div>
{% endblock page_content %}

{% block javascripts %}

    <script src="{{ asset('js/js-year-calendar/js-year-calendar.min.js') }}"></script>
    <script src="{{ asset('js/js-year-calendar/js-year-calendar.fr.js') }}"></script>

	<script type="text/javascript">

        var dataSource  = {{ data|json_encode|raw }};

        const toDate = (dateStr) => {
            const [day, month, year] = dateStr.split("/")
            return new Date(year, month - 1, day)
        }

        $.each(dataSource, function(index, o) {
            o.startDate = toDate(o.startDate);
            o.endDate = toDate(o.endDate);
        });

		new Calendar('.calendar', {
            language: 'fr',
            dataSource: dataSource,
            style: 'custom',
            customDayRenderer: function(element, date) {
                if (date.toDateString() === new Date().toDateString()) {
                    $(element).addClass('calendar-today');
                }
            },
            customDataSourceRenderer: function(element, date, event) {
                $(element).css('background-color', event[0].color);
                $(element).css('color', 'white');
                $(element).css('border-radius', '0px');
            },
        });
	</script>

{% endblock %}
