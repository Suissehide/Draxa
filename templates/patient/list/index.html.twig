{% extends 'layout.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Patients{% endblock %}

{% block page_content %}
    <div class="page">
        <div class="page-head">
            <h1 class="page-title">Patients</h1>
            <div class="page-head__actions">
                <a href="{{ path('csv') }}" class="btn btn-default" id="command-export">{{ icons.icon('download', 17) }} Exporter CSV</a>
                <a href="{{ path('patient_add') }}" class="btn btn-primary" id="command-add" data-row-id="0">{{ icons.icon('plus', 17) }} Nouveau patient</a>
            </div>
        </div>

        <div class="patients-toolbar">
        <form class="radio-block" onsubmit="return false">
            <div class="radio-group" role="radiogroup" aria-label="État du patient">
                <input type="radio" id="option-actuels" name="selector" checked>
                <label for="option-actuels">Actuels</label>
                <input type="radio" id="option-sortis" name="selector">
                <label for="option-sortis">Sortis</label>
                <input type="radio" id="option-tous" name="selector">
                <label for="option-tous">Tous</label>
            </div>
        </form>
        <div class="patients-filters" role="group" aria-label="Filtres">
            <label class="sr-only" for="filter-progetp">Programme</label>
            <select id="filter-progetp" class="form-control js-filter" data-key="progetp">
                <option value="">Tous les programmes</option>
                <option value="ViVa">ViVa</option>
                <option value="ViVa module AOMI">ViVa module AOMI</option>
            </select>
            <label class="sr-only" for="filter-diagnostic">Diagnostic médical</label>
            <select id="filter-diagnostic" class="form-control js-filter" data-key="diagnostic">
                <option value="">Tous les diagnostics</option>
                <option value="AOMI">AOMI</option>
                <option value="AVC">AVC</option>
                <option value="CORONAROPATHIE">Coronaropathie</option>
                <option value="PREVENTION">Prévention</option>
            </select>
            <label class="filter-toggle"><input type="checkbox" class="js-filter" data-key="observ"><span class="alert-dot" aria-hidden="true"></span>Suivi à régulariser</label>
            <label class="filter-toggle"><input type="checkbox" class="js-filter" data-key="divers"><span class="tag tag--tf">TF</span>Theraflow</label>
            <button type="button" class="filter-reset js-filter-reset" hidden>Réinitialiser</button>
        </div>
        </div>
        <div class="legend legend--card legend--inline">
            <span class="legend__item"><span class="alert-dot" aria-hidden="true"></span>Suivi à régulariser</span>
            <span class="legend__item"><span class="tag tag--tf">TF</span>Theraflow</span>
            <span class="legend__item"><span class="tag tag--aomi">AOMI</span>ViVa module AOMI</span>
            <span class="legend__item"><span class="tag tag--out">Sorti</span>Sorti du programme</span>
            <span class="presence presence--oui presence--static"><i></i>Venu</span>
            <span class="presence presence--non presence--static"><i></i>Absent</span>
            <span class="presence presence--static"><i></i>À renseigner</span>
        </div>

        <section class="card patients-card">
            <table id="patient-grid" class="table table-condensed table-hover table-clickable">
                <thead>
                <tr>
                    <th data-column-id="observ" data-formatter="observ" data-sortable="false" data-width="34px"></th>
                    <th data-column-id="id" data-type="numeric" data-identifier="true" data-visible="false">Id</th>
                    <th data-column-id="nom" data-formatter="patient" data-width="24%">Patient</th>
                    <th data-column-id="tel1" data-width="13%">Téléphone</th>
                    <th data-column-id="date" data-formatter="next" data-width="22%">Prochain rendez-vous</th>
                    <th data-column-id="objectif" data-searchable="false">Objectif</th>
                    <th data-column-id="etp" data-width="13%">Point final ETP</th>
                    <th data-column-id="venu" data-formatter="venu" data-sortable="false" data-width="150px">Présence</th>
                    <th data-column-id="status" data-visible="false" data-searchable="false">Status</th>
                </tr>
                </thead>
            </table>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        let etat = "in";
        // Filtres mémorisés pendant la session de navigation
        let filters = JSON.parse(sessionStorage.getItem('patientFilters') || '{}');
        const categorieLabels = {Consultation: 'Consultation', Entretien: 'Entretien', Coaching: 'Coaching PRM', Atelier: 'Atelier', Educative: 'Semaine éd.'};

        $("#patient-grid").bootgrid({
            rowCount: [100, 25, -1],
            columnSelection: false,
            ajax: true,
            statusMapping: {0: "in", 1: "out", 2: "aomi"},
            requestHandler: function (request) {
                request.etat = etat;
                return $.extend(request, filters);
            },
            url: "{{ path('patient_list') }}",
            labels: {
                all: 'Tous', infos: '{{ '{{' }}ctx.start{{ '}}' }}–{{ '{{' }}ctx.end{{ '}}' }} sur {{ '{{' }}ctx.total{{ '}}' }} patients',
                loading: 'Chargement…', noResults: 'Aucun patient', refresh: 'Actualiser', search: 'Nom, prénom, téléphone…'
            },
            formatters: {
                "observ": function (column, row) {
                    return row.observ ? '<span class="alert-dot" role="img" aria-label="Suivi à régulariser" title="Suivi à régulariser"></span>' : '';
                },
                "patient": function (column, row) {
                    let tags = '';
                    if (row.divers) tags += '<span class="tag tag--tf" title="Theraflow">TF</span>';
                    if (row.progetp === 'ViVa module AOMI') tags += '<span class="tag tag--aomi" title="ViVa module AOMI">AOMI</span>';
                    if (row.sortie) tags += '<span class="tag tag--out">Sorti le ' + escapeHtml(row.sortie) + '</span>';
                    return '<div class="pt"><div>'
                        + '<div class="pt-name">' + escapeHtml(row.nom) + ' <span>' + escapeHtml(row.prenom) + '</span></div>'
                        + (tags ? '<div class="pt-tags">' + tags + '</div>' : '') + '</div></div>';
                },
                "next": function (column, row) {
                    if (!row.date) return '<span class="chip__muted">—</span>';
                    return '<div class="next-rdv"><span>' + escapeHtml(row.date) + '</span><small><span class="cat-dot cat-dot--' + escapeHtml(String(row.categorie).toLowerCase()) + '"></span>'
                        + escapeHtml(categorieLabels[row.categorie] || row.categorie) + (row.thematique ? ' · ' + escapeHtml(row.thematique) : '') + '</small></div>';
                },
                "venu": function (column, row) {
                    if (row.venu === 'Oui') return '<span class="presence presence--oui presence--display"><i></i>Venu</span>';
                    if (row.venu === 'Non') return '<span class="presence presence--non presence--display"><i></i>Absent</span>';
                    if (row.date) return '<span class="presence presence--display"><i></i>À renseigner</span>';
                    return '';
                }
            }
        }).on("loaded.rs.jquery.bootgrid", function () {
            // Lignes atteignables au clavier (Entrée ouvre la fiche)
            $("#patient-grid tbody tr[data-row-id]").attr({tabindex: 0, title: 'Ouvrir la fiche du patient'});
        });

        // Branché une seule fois (et non à chaque rechargement de la grille) ; Ctrl/Cmd+clic ouvre un nouvel onglet.
        function openPatientRow(tr, newTab) {
            const npatient = $(tr).data('row-id');
            if (npatient === undefined) {
                return;
            }
            const url = "{{ path('patient_vue', {'id': 0}) }}".replace(/0$/, npatient);
            if (newTab) {
                window.open(url, '_blank');
            } else {
                window.location.assign(url);
            }
        }

        $("#patient-grid").on("click", "tbody tr", function (e) {
            openPatientRow(this, e.ctrlKey || e.metaKey);
        }).on("auxclick", "tbody tr", function (e) {
            if (e.button === 1) {
                openPatientRow(this, true);
            }
        }).on("keydown", "tbody tr", function (e) {
            if (e.key === 'Enter') {
                openPatientRow(this, false);
            }
        });

        function syncFilters() {
            $('.js-filter').each(function () {
                const v = filters[$(this).data('key')];
                if (this.type === 'checkbox') this.checked = v === '1'; else $(this).val(v || '');
            });
            $('.js-filter-reset').prop('hidden', Object.keys(filters).length === 0);
        }
        syncFilters();
        $('.js-filter').on('change', function () {
            const key = $(this).data('key');
            const value = this.type === 'checkbox' ? (this.checked ? '1' : '') : $(this).val();
            if (value) filters[key] = value; else delete filters[key];
            sessionStorage.setItem('patientFilters', JSON.stringify(filters));
            syncFilters();
            $("#patient-grid").bootgrid('reload');
        });
        $('.js-filter-reset').on('click', function () {
            filters = {};
            sessionStorage.removeItem('patientFilters');
            syncFilters();
            $("#patient-grid").bootgrid('reload');
        });

        $(".radio-block input[type=radio]").on("change", function () {
            if (this.id === "option-tous")
                etat = "all";
            else if (this.id === "option-actuels")
                etat = "in";
            else if (this.id === "option-sortis")
                etat = "out";
            $("#patient-grid").bootgrid('reload');
        })
    </script>
{% endblock %}
